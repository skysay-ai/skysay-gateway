{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skysay.ai/contracts/gateway-v1/call_realtime_config.json",
  "title": "CallRealtimeConfig",
  "type": "object",
  "required": [
    "call_id",
    "direction",
    "agent_id",
    "organization_id",
    "project_id",
    "language",
    "system_prompt",
    "first_message",
    "tools",
    "recording_enabled",
    "transcriber",
    "model",
    "voice",
    "answer_detection"
  ],
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "const": "outbound"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "et",
        "si"
      ]
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "first_message": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recording_enabled": {
      "const": true
    },
    "transcriber": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "voice": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "latency": {
      "type": "object"
    },
    "selectable": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array"
    },
    "media_stack": {
      "type": "string"
    },
    "turn_taking": {
      "type": "object"
    },
    "voice_polish": {
      "type": "object"
    },
    "answer_detection": {
      "type": "object",
      "required": [
        "non_human_audio",
        "voicemail"
      ],
      "properties": {
        "non_human_audio": {
          "type": "string",
          "minLength": 1
        },
        "voicemail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_storage": {
      "type": "string",
      "enum": [
        "skysay",
        "gateway"
      ],
      "description": "Where this deployment keeps call content. 'gateway' (content-local): keep recordings, transcripts and evidence on the gateway and send Skysay no call content. A self-hosted worker refuses a config without this field."
    }
  },
  "additionalProperties": false
}
