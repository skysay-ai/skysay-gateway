# SPDX-License-Identifier: Apache-2.0
# OpenPhonex Gateway — self-host env (existing Asterisk container).
# Copy to `.env.selfhost` and fill in. NEVER commit the filled-in file.
# Placeholders only — every default below matches the worker's
# openphonex_gateway.realtime.worker.RealtimeWorkerConfig.from_env().
#
# Pass this file TWICE, on purpose:
#   docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d --build
# `--env-file` feeds compose interpolation (network name / static IP);
# the service `env_file:` entry feeds the same file to the container.

# --- Compose topology (interpolation-only; not read by the worker) ------------
# Your existing Asterisk container's docker network:
#   docker network ls
#   docker inspect <asterisk-container> --format '{{json .NetworkSettings.Networks}}'
ASTERISK_DOCKER_NETWORK=my-asterisk_default
# A FREE static IP on that network's subnet for the gateway container
# (docker network inspect shows the subnet + taken addresses).
GATEWAY_STATIC_IP=172.18.0.10
# Host loopback port for the worker health endpoint (127.0.0.1:<port> -> 18772).
GATEWAY_HEALTH_HOST_PORT=18772

# --- Asterisk ARI --------------------------------------------------------------
# ARI base URL: your Asterisk container's IP (or DNS alias) on the shared
# network, port 8088, path /ari. Requires ARI enabled in http.conf + ari.conf.
ASTERISK_ARI_URL=http://172.18.0.2:8088/ari
ASTERISK_ARI_USER=voicebot
ASTERISK_ARI_PASSWORD=
# The Stasis application name your dialplan routes calls into, e.g.
# `same => n,Stasis(voicebot)`. ONE consumer per app — see SELFHOST.md.
ASTERISK_ARI_APP=voicebot

# --- RTP topology (ExternalMedia, container-to-container) ----------------------
# Where Asterisk sends ExternalMedia RTP = the gateway's static IP above.
ASTERISK_EXTERNAL_MEDIA_HOST=172.18.0.10
# Where the gateway sends RTP back = the Asterisk container's IP. If left
# empty the worker falls back to the UNICASTRTP_LOCAL_ADDRESS Asterisk reports,
# which can be wrong on multi-homed hosts — set it explicitly.
ASTERISK_RTP_HOST=172.18.0.2
# UDP port pool the gateway binds for RTP (one port per concurrent call).
VOICE_RTP_PORT=12000
VOICE_RTP_PORT_END=12019

# --- Worker health/status endpoint ---------------------------------------------
# Must be 0.0.0.0 so the compose port mapping (loopback-only on the host) can
# reach it; the worker default is 127.0.0.1 which is unreachable from outside
# the container.
REALTIME_HEALTH_BIND=0.0.0.0
# Keep 18772 — the compose file publishes container port 18772.
REALTIME_HEALTH_PORT=18772

# --- Live-call gate (fail-closed) ------------------------------------------------
# The worker REFUSES to serve Asterisk until this is 1 (it logs
# ari_connect_error with "Set REALTIME_LIVE_ENABLED=1 ..." and retries).
# Flip to 1 only when providers + ARI are configured and you intend real calls.
REALTIME_LIVE_ENABLED=0

# --- Pipeline / providers --------------------------------------------------------
# Streaming Deepgram STT -> Gemini LLM -> ElevenLabs v3 TTS (the pipeline
# validated live on the reference deployment).
REALTIME_PROVIDER_MODE=deepgram_gemini_elevenlabs_v3
# BCP-47-ish language for STT + TTS defaults (worker default: et).
REALTIME_LANGUAGE=et

# Deepgram streaming STT
DEEPGRAM_API_KEY=
# nova-2 is the model validated live for Estonian; the worker default is nova-3.
DEEPGRAM_MODEL_ID=nova-2
# Defaults to REALTIME_LANGUAGE when UNSET (an empty value counts as set —
# keep it commented out unless you want a different STT language).
# DEEPGRAM_LANGUAGE=
# Deepgram's documented minimum is 1000; the worker clamps lower values up to
# 1000 (below that Deepgram rejects the WebSocket handshake with HTTP 400).
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_ENDPOINTING_MS=300

# Gemini LLM
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
# System prompt for the voice agent (single line; keep it short).
GEMINI_SYSTEM_PROMPT=
GEMINI_MAX_OUTPUT_TOKENS=120
GEMINI_TEMPERATURE=0.3

# ElevenLabs v3 TTS
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
# Defaults to REALTIME_LANGUAGE when UNSET (an empty value counts as set —
# keep it commented out unless TTS should differ from REALTIME_LANGUAGE).
# ELEVENLABS_LANGUAGE_CODE=
# Either a concrete voice id ...
ELEVENLABS_VOICE_ID=
# ... or a voice NAME hint the worker resolves via the ElevenLabs API.
ELEVENLABS_VOICE=

# --- Conversation behavior --------------------------------------------------------
# Barge-in RMS threshold. 650 (worker default) is sensitive — any caller frame
# cancels agent audio; raising it toward 32000 makes the agent effectively
# half-duplex so telephony echo/comfort noise no longer cuts replies mid-word.
REALTIME_BARGE_IN_RMS=650
# What the agent says first on OUTBOUND calls (after the callee answers).
# UNSET uses the built-in default ("Tere! Siin OpenPhonexi digiassistent. Kas
# teil on hetk aega?"); an EMPTY value means "say nothing" — so keep it
# commented out unless you set real text.
# REALTIME_OPENING_UTTERANCE=Hello! This is the OpenPhonex digital assistant. Do you have a moment?
# What the agent says first on INBOUND calls (falls back to
# REALTIME_OPENING_UTTERANCE, then the built-in inbound default "Tere! Siin
# OpenPhonexi digiassistent. Kuidas saan teid aidata?").
# REALTIME_INBOUND_OPENING_UTTERANCE=Hello! This is the OpenPhonex digital assistant. How can I help?
REALTIME_MAX_TURNS=4
REALTIME_IDLE_TIMEOUT_SECONDS=30

# --- ARI connect resilience (defaults shown; rarely need changing) -----------------
# 0 = retry forever with bounded backoff (a transient "Asterisk not ready yet"
# at container start self-heals instead of crash-looping).
REALTIME_ARI_CONNECT_MAX_ATTEMPTS=0
REALTIME_ARI_CONNECT_BACKOFF_SECONDS=2
REALTIME_ARI_CONNECT_BACKOFF_MAX_SECONDS=30

# --- Outbound originate CLI (openphonex-originate; see SELFHOST.md) ----------------
# SIP host your PJSIP endpoint dials out through, e.g. out.example-provider.com.
DIDWW_OUTBOUND_HOST=
# Caller ID presented on outbound calls (a number you are entitled to present;
# anonymous caller IDs get rejected by many trunks with 403).
DIDWW_CALLER_ID=
# Stasis appArgs for originated calls; the worker treats this as direction.
ASTERISK_ARI_APP_ARGS=outbound
# Originate ring timeout in seconds.
ASTERISK_ARI_TIMEOUT=45

# --- OpenPhonex Cloud (OPTIONAL — leave UNSET for standalone self-hosting) ---------
# With these unset the worker NEVER contacts OpenPhonex Cloud; even
# --report-health / --report-health-once short-circuit to
# {"configured": false} without any HTTP call. Only fill these if you attach
# this gateway to a managed OpenPhonex Cloud deployment (topology B).
# OPENPHONEX_API_URL=
# OPENPHONEX_GATEWAY_ID=
# OPENPHONEX_GATEWAY_API_TOKEN=
# OPENPHONEX_GATEWAY_PUBLIC_URL=
