# SPDX-License-Identifier: Apache-2.0
# OpenPhonex LiveKit self-host — agent environment template.
#
#   cp .env.livekit.example .env.livekit && chmod 600 .env.livekit
#
# Fill in EVERY variable below (each one says what it is, where to get it, and
# what it looks like). NEVER commit the filled-in copy — the repo .gitignore
# excludes it, and the release secret-scanner refuses .env files.
#
# VALUE SAFETY: this file is `source`d by the container entrypoint, so avoid
# shell metacharacters ($, `` ` ``, quotes) in values. If a credential must
# contain them, single-quote the whole value (e.g. FOO='a$b`c') so it is taken
# literally.
#
# This file is bind-mounted read-only into the agents / reconciler /
# provision containers at /run/sch172/carrier.env and sourced by the
# production entrypoint before it drops privileges. Variable names are the
# PRODUCTION names (the agent code is byte-identical to what OpenPhonex
# production runs; the SCH236_/SCH172_ prefixes come from that lineage).
#
# After filling everything in:  bash selfhost-smoketest.sh  verifies each value.

# --- LiveKit (this stack) -----------------------------------------------------
# WHAT:  websocket URL of the livekit-server started by this compose file.
# VALUE: the host-networked stack binds LiveKit to loopback, so this is the
#        default. The provision step REQUIRES this to be `wss://<host>` OR
#        `ws://` on an exact loopback host (127.0.0.0/8, ::1, localhost) — it
#        refuses a remote `ws://` URL, which would send the LiveKit admin JWT
#        (and any SIP credentials) in plaintext.
LIVEKIT_URL=ws://127.0.0.1:7880

# WHAT:  the LiveKit API credential pair for THIS stack. You invent it — it is
#        not issued by anyone.
# HOW:   key: any short id (e.g. `opx-selfhost`); secret: `openssl rand -hex 32`.
# MUST:  be the SAME pair you put in livekit.yaml (under `keys:`) and sip.yaml
#        (`api_key` / `api_secret`). Three files, one pair.
# LOOKS: LIVEKIT_API_KEY=opx-selfhost
#        LIVEKIT_API_SECRET=9f2c... (64 hex chars)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- OpenPhonex control plane (per-call config resolution) --------------------
# The agent admits NO media until the control plane has resolved the number
# route and the agent's realtime-config (prepare_inbound -> realtime-config,
# contracts/gateway-v1.yaml).
#
# WHAT:  base URL of the OpenPhonex control plane (Cloud, or your own deployment).
# MUST:  be https:// — the agent REFUSES to send bearer tokens over plaintext
#        http unless the host is verified loopback (127.0.0.0/8, ::1, localhost).
# LOOKS: https://api.openphonex.com  (Cloud)  or  http://127.0.0.1:18765 (local)
OPENPHONEX_CONTROL_PLANE_URL=

# WHAT:  your gateway deployment id.
# WHERE: create one: POST /v1/gateway-deployments (or dashboard -> Gateways ->
#        New self-hosted gateway). The response id is this value.
# LOOKS: gw_01HZX... (starts with gw_)
OPENPHONEX_GATEWAY_ID=

# WHAT:  the per-gateway API token scoped to that deployment (lifecycle events,
#        outbound authorization, artifact upload).
# WHERE: workspace -> API Keys -> Gateway Tokens, after registering this
#        deployment. The one-time reveal includes the exact full line
#        OPENPHONEX_GATEWAY_API_TOKEN=tgw_...; replace the blank assignment
#        below with that revealed line (do not paste it after the `=`).
#        The token is deployment-bound, shown ONCE, and cannot be a worker key.
# LOOKS: tgw_... (24+ chars after the prefix)
OPENPHONEX_GATEWAY_API_TOKEN=

# WHAT:  the ORGANIZATION-scoped worker token used for inbound call routing
#        (POST /v1/calls/inbound/route) and MCP schema discovery
#        (POST /mcp tools/list). Model tool calls stay call-bound.
# WHERE: workspace -> API Keys -> the separate regular API Keys card ->
#        Create self-host worker key. Do NOT create this from Gateway Tokens.
# NOTE:  org-scoped by design (mirrors production) — anyone who can read this
#        file can run the self-host worker for the WHOLE organization.
#        Keep this box locked down; rotate immediately on any suspicion.
#        See SECURITY.md ("Worker token") in the repo root.
# LOOKS: tai_... (24+ chars after the prefix)
# SCOPES: the self-host worker preset grants calls:read + calls:write for
#        inbound routing and its immediate call-bound runtime-config read.
#        It deliberately excludes global worker_jobs:* access; this compose
#        disables the non-critical global heartbeat loop for the baseline key.
#        The optional outbound profile needs a separately reviewed credential.
OPENPHONEX_WORKER_API_TOKEN=

# WHAT:  the organization that owns the inbound DID below. It must be the same
#        workspace that minted OPENPHONEX_WORKER_API_TOKEN; a cross-workspace
#        tai_ key is rejected during inbound routing.
# WHERE: dashboard -> organization settings (the org id), or GET /v1/organizations.
# LOOKS: org_01HZX...
OPENPHONEX_ORGANIZATION_ID=

# WHAT:  the inbound phone number (DID) this agent answers. The control plane
#        must have a phone-number route + agent configured for it.
# WHERE: the DID you bought from your carrier and registered in OpenPhonex.
# LOOKS: E.164 WITH leading + : +15551230000
SCH236_TEST_DID_E164=

# --- AI providers (the production pipeline) -----------------------------------
# Deepgram nova-3 (STT) -> Gemini (LLM) -> ElevenLabs (TTS). Which model and
# voice run per call is resolved from the control plane's realtime-config;
# these keys authenticate against the providers.
#
# WHERE: DEEPGRAM_API_KEY   https://console.deepgram.com  -> API Keys
#        GEMINI_API_KEY     https://aistudio.google.com   -> Get API key
#        ELEVENLABS_API_KEY https://elevenlabs.io         -> Profile -> API Keys
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- si-LK (Sinhala) voice stack (optional) ------------------------------------
# Only needed if an agent is configured for language=si. Neither Deepgram nor
# ElevenLabs supports Sinhala, so si-LK calls resolve to a different stack:
# Google Cloud STT v2 Chirp 2 (STT) -> Gemini (LLM, same GEMINI_API_KEY above)
# -> Gemini-TTS (TTS, also the same GEMINI_API_KEY -- no separate key needed).
# See SELFHOST.md "Language stacks: Sinhala (si-LK)" for the GCP service-
# account setup steps.
#
# WHAT:  GCP credentials for the Chirp 2 Speech-to-Text API. This is a real GCP
#        service account, NOT the Gemini API key above -- Chirp 2 is a Cloud
#        Speech-to-Text v2 API call, not a Gemini API call. Set exactly ONE of
#        the two variables below (the inline JSON is tried first if both are set).
# WHERE: GCP Console -> IAM & Admin -> Service Accounts -> create one with the
#        "Cloud Speech Client" role (roles/speech.client) -> Keys -> Add key
#        (JSON). Enable the "Cloud Speech-to-Text API" on the project first.
# GOOGLE_APPLICATION_CREDENTIALS: absolute path to the downloaded service-
#        account JSON key file, mounted read-only into the container.
# GOOGLE_APPLICATION_CREDENTIALS_JSON: the SAME service-account JSON, inlined
#        as a single-line env var instead of a file -- for platforms that only
#        support secrets-as-env-vars. Single-quote the value (it contains ").
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# WHAT:  the Cloud Speech-to-Text v2 recognizer location (region). Chirp 2 in
#        `asia-southeast1` is empirically verified to support si-LK against the
#        live API; Chirp 3 rejects si-LK with an HTTP 400 in both `eu` and `us`.
# VALUE: default `asia-southeast1`; leave unset unless you have a reason to change it.
GOOGLE_STT_LOCATION=asia-southeast1

# --- Agent tuning (optional) --------------------------------------------------
# WHAT:  warm idle job processes — removes the per-call cold start.
# VALUE: clamped to [1, 16]; default 2. Leave as is unless you know better.
SCH236_NUM_IDLE_PROCESSES=2

# --- One-shot `provision` bootstrap (docker compose --profile provision) ------
# Creates the LiveKit SIP INBOUND trunk + dispatch rule for your DID so an
# incoming call reaches the agent. Run once after the stack is up; rerun only
# when the DID or the carrier allowlist changes. On success it prints
# `SELFHOST_PROVISIONED {...}`; on any error `SELFHOST_PROVISION_FAILED {...}`
# with the exact reason. The DID it uses is SCH236_TEST_DID_E164 above — you do
# NOT set it twice.

# REQUIRED for provisioning:
# WHAT:  the PUBLIC IPv4 CIDR ranges your carrier sends SIP INVITEs FROM — the
#        SIGNALING ranges only (NOT the RTP/media ranges). Inbound INVITEs from
#        anywhere else are rejected by the trunk. Must be globally-routable
#        ranges (private/loopback/documentation ranges are rejected — a real
#        carrier never signals from them). The carrier's RTP/media ranges do
#        NOT go here; they only need the 10000-10100/udp firewall opening.
# WHERE: your carrier portal's "signaling IPs" / "SIP server IPs" page
#        (DIDWW: Support -> IP addresses).
# LOOKS: 203.0.113.0/24,198.51.100.0/28  <-- EXAMPLE ONLY; replace with your
#        carrier's real ranges (the example is a documentation range and is
#        rejected on purpose so you don't provision an allowlist no call matches).
DIDWW_INBOUND_ADDRESSES=

# OPTIONAL — outbound trunk. Only needed to place calls OUT (inbound answering
# works without these). Supply ALL FOUR to also create an outbound trunk, or
# leave ALL FOUR blank for inbound-only. A partially-filled set is rejected
# with a clear error.
# WHERE: your carrier portal's outbound trunk page (DIDWW: SIP trunks).
# LOOKS: DIDWW_OUTBOUND_HOST=sip.yourcarrier.com   (DNS hostname, no scheme)
#        DIDWW_OUTBOUND_FROM_USER=15551230000      (digits, no +), or
#        15551230000,37255501234 for multiple permitted caller IDs
#        auth pair: whatever the carrier issued for the trunk
DIDWW_OUTBOUND_HOST=
DIDWW_OUTBOUND_FROM_USER=
DIDWW_OUTBOUND_AUTH_USERNAME=
DIDWW_OUTBOUND_AUTH_PASSWORD=

# --- Registering SIP sidecar (optional; only for a host behind NAT) ----------
# Its settings live in a SEPARATE file, `.env.registrar`, on purpose — see
# `.env.registrar.example`. The sidecar is the most exposed process in this
# stack (host-networked, parsing SIP straight off the internet), and Docker's
# env_file has no way to pass part of a file: whatever you point it at, the
# container gets all of. Keeping the two apart means a compromise of the SIP
# proxy does not hand over the control-plane tokens and provider API keys
# above. Leave this alone entirely if your host has a public IP.

# --- Outbound worker (optional; required to place calls) ---------------------
# Both gates are required: start compose with `--profile outbound` AND set the
# explicit execution gate to 1. Keep it 0 for inbound-only/dry-run staging.
OPENPHONEX_EXECUTE_LIVEKIT_OUTBOUND=0
OPENPHONEX_OUTBOUND_WORKER_ID=livekit-outbound-1
OPENPHONEX_OUTBOUND_TRUNK_NAME=openphonex-selfhost-outbound
OPENPHONEX_OUTBOUND_POLL_SECONDS=2
OPENPHONEX_OUTBOUND_RINGING_TIMEOUT_SECONDS=45
OPENPHONEX_OUTBOUND_MAX_CALL_DURATION_SECONDS=1800
