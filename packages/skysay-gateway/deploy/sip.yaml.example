# SPDX-License-Identifier: Apache-2.0
# Skysay LiveKit self-host — livekit-sip config template.
# Copy to `sip.yaml` and fill in the SAME key pair as `livekit.yaml`. NEVER
# commit the copy.
#
# Shape: SIP signaling on UDP 5060, RTP on
# UDP 10000-10100, LiveKit + Redis reached over loopback on the host network.
# Open 5060/udp and 10000-10100/udp to YOUR carrier's signaling/media ranges
# only (host firewall / cloud firewall) — never to the whole internet.

api_key: changeme-api-key
api_secret: changeme-api-secret
ws_url: ws://127.0.0.1:7880
redis:
  address: 127.0.0.1:6380
sip_port: 5060
rtp_port: 10000-10100
use_external_ip: true
logging:
  level: info
