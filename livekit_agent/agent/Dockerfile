# Skysay LiveKit agent — PUBLIC self-host image (generated by the OSS
# export; template: scripts/oss-release/templates/Dockerfile.livekit-agent).
#
# This is the minimal RUNTIME image for the self-host stack: the same pinned
# base image, dependency install, and entrypoint hardening as the production
# voice box, COPYing only the runtime import closure of the three self-host
# entrypoints (production_agent.py, outbound_worker.py,
# reconcile_sessions.py, provision_selfhost.py).
# The internal qualification/demo tooling that the private production image
# additionally carries is deliberately absent. Export tests assert the FROM
# pin matches production and that the COPY set covers the import closure.
FROM python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN adduser --disabled-password --gecos "" --uid 10001 agent
WORKDIR /app
COPY agent/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --requirement /app/requirements.txt
COPY agent/azure_stt_cleanup_patch.py /app/azure_stt_cleanup_patch.py
RUN --network=none python /app/azure_stt_cleanup_patch.py
# The Silero VAD checkpoint is a release input pinned by digest, not whatever
# the installed plugin happens to bundle: a plugin upgrade that swaps the file
# must fail THIS build instead of silently moving every interruption threshold
# on a live call.  Since 2026-09-15 the pinned bytes are the checkpoint the
# installed livekit-plugins-silero bundles (the v6.1 file pinned before it
# under-detected quiet narrowband PSTN callers), so copy the file out of the
# installed distribution -- by its RECORD entry, without importing the SDK --
# and verify its digest here.  ``prewarm.py`` binds this exact path into every
# VAD load site.
RUN mkdir -p /app/models \
 && python -c "import hashlib, sys; from importlib.metadata import files; entries = [f for f in (files('livekit-plugins-silero') or ()) if f.as_posix() == 'livekit/plugins/silero/resources/silero_vad.onnx']; assert len(entries) == 1, 'livekit-plugins-silero no longer ships resources/silero_vad.onnx'; data = entries[0].read_binary(); digest = hashlib.sha256(data).hexdigest(); expected = sys.argv[1]; assert digest == expected, 'pinned Silero VAD checkpoint digest ' + digest + ' != ' + expected; open(sys.argv[2], 'wb').write(data)" 1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3 /app/models/silero_vad_pinned.onnx \
 && chmod 0444 /app/models/silero_vad_pinned.onnx
USER agent
RUN python -m livekit.agents download-files
USER root
COPY agent/gemini_opening.py agent/opening_output.py agent/browser_startup_output.py agent/graceful_stop_output.py agent/playout_hold_output.py agent/production_agent.py agent/outbound_worker.py agent/reconcile_sessions.py agent/provision_selfhost.py /app/
COPY calendar_tools.py tool_declarations.py /app/
COPY audio_environment.py acknowledgements.py tool_wait.py call_telemetry.py control_plane.py workflow_requests.py demo.py evidence_contract.py first_clause.py gpt_live_runtime.py livekit_evidence.py prewarm.py production.py reconciliation.py session_state_file.py worker_drain.py /app/
COPY answer_classifier.py post_answer_arbiter.py answer_detection.py /app/
COPY voicemail_signals.py voicemail_watch.py answer_observer.py /app/
COPY usage_report_outbox.py realtime_session_clock.py browser_startup.py caller_audio_flow.py turn_end_evidence.py component_billing.py component_credentials.py error_tracking.py graceful_stop.py interruption_boundary.py playout_hold.py runtime_language_switch.py transcript_events.py call_transcript_events.py closing_evidence.py evidence_sidecar.py realtime_event_trace.py sip_answer_gate.py workflow_turns.py spoken_language.py native_tts_usage.py gemini_tts_usage.py gemini_tts.py google_stt.py soniox_usage.py soniox_stt.py soniox_tts.py fish_audio_tts.py cartesia_tts.py elevenlabs_tts.py azure_speech.py transcription_stall.py unrecognised_speech.py model_unresponsive.py mutual_silence.py funded_runtime.py duplex_opening_hold.py native_caller_floor.py live_opening.py phone_admission.py agents_readiness.py check_in.py sip_call_statistics.py duplex_liveness.py live_reply_recovery.py transcript_coverage.py worker_events.py end_call_guard.py closing_classifier.py navigation_entry.py opening_turn.py leading_silence.py /app/
COPY workflow_speech_segments.py workflow_pickup.py workflow_root_plan.py workflow_root.py workflow_lifecycle_ack.py /app/
# The root's evidence parity (opening + caller-audio summaries) and its line latency ledger.
COPY workflow_root_evidence.py /app/
# The live output role: the call's one GPT-Live session speaks each reply.
COPY workflow_live_output.py /app/
COPY workflow_root_language.py workflow_azure_listener.py workflow_azure_listener_worker.py workflow_soniox_listener.py workflow_deepgram_listener.py workflow_openai_transcribe_listener.py /app/
COPY workflow_plugin_authored.py workflow_elevenlabs_authored.py workflow_azure_authored.py workflow_fishaudio_authored.py workflow_soniox_authored.py /app/
COPY workflow_authored_wire.py workflow_gemini_authored.py workflow_gemini_authored_worker.py /app/
COPY transfer.py transfer_dial.py /app/
COPY conversation_engines_generated.py /app/conversation_engines_generated.py
COPY action_inputs.py action_listener.py source_keys.py workflow_detector.py /app/
COPY workflow_input.py workflow_input_capture.py workflow_input_recognition.py workflow_room_input.py workflow_listener_runtime.py workflow_call.py workflow_tasks.py /app/
COPY voice_configuration.py workflow_input_ring.py workflow_listener_source.py workflow_source_owner.py workflow_source_transport.py workflow_source_meter.py /app/
COPY workflow_speech_preparation.py workflow_authored_tts.py workflow_reply_output.py workflow_speech.py workflow_playback.py workflow_segment_delivery.py workflow_delivery_transport.py /app/
COPY capabilities /app/capabilities
RUN --network=none python -c "import action_inputs, action_listener, source_keys, workflow_detector, workflow_root, workflow_root_plan, workflow_pickup, workflow_speech_segments, workflow_room_input, workflow_listener_runtime, workflow_listener_source, workflow_source_meter, workflow_call, workflow_reply_output; assert workflow_room_input.WorkflowRoomInput and workflow_listener_runtime.build_workflow_source and workflow_call.WorkflowCall and workflow_reply_output.WorkflowReplyOutput"
# Finite authored sources over the pinned TTS plugins: import offline, one factory signature each.
RUN --network=none python -c "import inspect, workflow_elevenlabs_authored, workflow_azure_authored, workflow_fishaudio_authored, workflow_soniox_authored; base = ('secret', 'constructor', 'client_reference_id'); assert tuple(inspect.signature(workflow_azure_authored.build_azure_authored_source).parameters) == base + ('region',); assert all(tuple(inspect.signature(build).parameters) == base for build in (workflow_elevenlabs_authored.build_elevenlabs_authored_source, workflow_fishaudio_authored.build_fishaudio_authored_source, workflow_soniox_authored.build_soniox_authored_source))"
# The live output: offline import, the registry factory signature, and the pinned SDK prefix it bounds.
RUN --network=none python -c "import inspect, workflow_live_output; from livekit.agents.llm._realtime.gpt_live import _ASK_INSTRUCTED; from livekit.plugins.openai.realtime import GPTLiveModel; assert tuple(inspect.signature(workflow_live_output.build_live_workflow_output).parameters) == ('secret', 'constructor', 'client_reference_id'); assert len((_ASK_INSTRUCTED + chr(10) * 2).encode()) == workflow_live_output.SDK_ASK_PREFIX_UTF8"
COPY workflow_playback_selftest.py /app/workflow_playback_selftest.py
RUN --network=none python /app/workflow_playback_selftest.py
COPY audio-environment /app/audio-environment
# The self-host image carries the same immutable CC0 pack as the production
# worker. Verify every advertised asset offline during build so a selected
# optional output bed is never advertised by a complete control plane and then
# missing or damaged in this image.
RUN cd /app && python -c "import audio_environment, json; from pathlib import Path; root = Path('/app/audio-environment/v1'); manifest = json.loads((root / 'manifest.json').read_text(encoding='utf-8')); assets = manifest.get('assets'); expected = {'quiet-office', 'call-centre', 'cafe', 'street', 'television'}; assert isinstance(assets, list) and len(assets) == len(expected) and all(isinstance(item, dict) for item in assets); assert {str(item.get('preset_id') or '') for item in assets} == expected; assert all(audio_environment.verified_preset_asset(str(item.get('preset_id') or ''), str(item.get('asset_version') or ''), root=root).is_file() for item in assets)"
# Offline construction protects the pinned Cartesia plugin compatibility shim
# without opening a synthesis stream, making a provider request, or reading a
# real credential from the image build.
RUN cd /app && python -c "from cartesia_tts import CARTESIA_API_VERSION, build_tts; from native_tts_usage import NativeTTSUnitMeter, RequestBilling; from capabilities.registry import load_registry; from livekit.plugins.cartesia import tts as cartesia_plugin; kwargs = {'api_' + 'key': chr(120)}; client = build_tts(native_unit_meter=NativeTTSUnitMeter(RequestBilling.from_capability(load_registry().capability('tts', 'cartesia', 'sonic-3.6'))), model='sonic-3.6', voice='offline-voice-id', language='ta', **kwargs); rest = cartesia_plugin._to_cartesia_options(client._opts, streaming=False); stream = cartesia_plugin._to_cartesia_options(client._opts, streaming=True); assert cartesia_plugin.API_VERSION == CARTESIA_API_VERSION and cartesia_plugin.API_AUTH_HEADER == 'Authorization' and client._opts.api_key.startswith('Bearer ') and rest['voice'] == 'offline-voice-id' and rest['locale'] == 'ta' and 'language' not in rest and stream['voice'] == 'offline-voice-id' and stream['language'] == 'ta' and 'locale' not in stream"
# Fail the BUILD, not a call, if the release inputs this image is supposed
# to carry are not in the final layer.  Three things are checked offline --
# no network, no credential, no synthesis stream:
#
#   * the pinned Silero VAD checkpoint is present at the exact path
#     ``prewarm.py`` binds, with the exact digest.  Nothing today removes
#     it, but a future COPY that shadows /app/models would otherwise turn
#     into FileNotFoundError on the first call of a promoted image.
#   * livekit-plugins-elevenlabs still routes eleven_v3 through the
#     text-to-dialogue transport.  If a dependency rebuild loses that, the
#     model goes back to the realtime websocket that answers it with a 403
#     and the call connects, transcribes, and stays SILENT.  The offline
#     suite cannot see this -- it never imports the SDK -- so the build is
#     the only place it can be caught before a customer hears it.
#   * SDK 1.8.6 owns v4 routing. The worker retains similarity on its init
#     packet without replacing that route or changing v3/Flash settings.
RUN cd /app && python -c "import hashlib, inspect, sys; from pathlib import Path; from types import SimpleNamespace; from livekit.plugins.elevenlabs.models import is_dialogue_model; from livekit.plugins.elevenlabs import tts as el; from livekit.plugins.elevenlabs.tts import NOT_GIVEN, VoiceSettings; from prewarm import SILERO_VAD_PINNED_PATH, SILERO_VAD_PINNED_SHA256; from demo import install_eleven_v4_turbo_dialogue_route; p = Path(SILERO_VAD_PINNED_PATH); assert p.is_file(), 'pinned Silero VAD checkpoint missing at ' + str(p); assert hashlib.sha256(p.read_bytes()).hexdigest() == SILERO_VAD_PINNED_SHA256, 'pinned Silero VAD checkpoint digest changed in the final image'; assert is_dialogue_model('eleven_v3') and is_dialogue_model('eleven_v3_conversational'), 'eleven_v3 no longer takes the text-to-dialogue transport; it would 403 the realtime websocket and go silent'; assert not is_dialogue_model('eleven_flash_v2_5'), 'a streaming model must not be rerouted to text-to-dialogue'; assert is_dialogue_model('eleven_v4_turbo'), 'pinned plugin must route eleven_v4_turbo to dialogue'; install_eleven_v4_turbo_dialogue_route(); assert el.is_dialogue_model('eleven_v4_turbo') and el.is_dialogue_model('eleven_v3') and not el.is_dialogue_model('eleven_flash_v2_5'), 'SDK dialogue routing changed after the settings adapter installed'; assert el.is_dialogue_model is is_dialogue_model, 'worker must not replace the SDK dialogue route'; _pkt = lambda model: el._build_dialogue_context_init_packet(SimpleNamespace(model=model, voice_id='voice', voice_settings=VoiceSettings(stability=0.45, similarity_boost=0.75), pronunciation_dictionary_locators=NOT_GIVEN), context_id='probe'); _v4, _v3 = _pkt('eleven_v4_turbo'), _pkt('eleven_v3'); assert _v4['voice_settings'].get('stability') == 0.45 and _v4['voice_settings'].get('similarity_boost') == 0.75, 'v4 dialogue init dropped similarity'; assert _v3.get('voice_settings') == {'stability': 0.45}, 'v3 dialogue init must stay stability-only'; assert hasattr(el, '_DialogueConnection'); _send = inspect.getsource(el._DialogueConnection); assert '_build_dialogue_context_init_packet(' in _send and 'await self._ws.send_json(init_pkt)' in _send, 'SDK dialogue send path no longer resolves and sends the patched init packet'"
COPY agent/carrier-entrypoint.sh /app/carrier-entrypoint.sh
RUN chmod 0555 /app/carrier-entrypoint.sh
USER agent

CMD ["python", "/app/production_agent.py", "start"]
