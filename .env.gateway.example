# OpenPhonex Gateway — topology B (managed numbers from Cloud + self-hosted
# gateway + local models). Copy to `.env.gateway` and fill in. NEVER commit the
# filled-in file. Every value here is a placeholder or a safe default; leave the
# token fields EMPTY until you mint real ones in OpenPhonex Cloud.

# --- Cloud registration (per-gateway, scoped) ---------------------------------
OPENPHONEX_API_URL=https://api.openphonex.com
# gw_... deployment id from POST /v1/gateway-deployments
OPENPHONEX_GATEWAY_ID=
# tgw_... per-gateway token from POST /v1/gateway-deployments/{gw}/tokens (shown once)
OPENPHONEX_GATEWAY_API_TOKEN=
# public URL of your audio tunnel, e.g. https://<tunnel-host>/audio
OPENPHONEX_GATEWAY_PUBLIC_URL=
OPENPHONEX_GATEWAY_LOCAL_STATUS_URL=http://127.0.0.1:18772/status
OPENPHONEX_GATEWAY_REPORT_INTERVAL_SECONDS=15

# --- Local models (M5 registry; leave REALTIME_PROVIDER_MODE unset so the
#     per-component providers below win) -------------------------------------
# REALTIME_PROVIDER_MODE=
REALTIME_STT_PROVIDER=faster_whisper
REALTIME_LOCAL_STT_MODEL=base
REALTIME_LOCAL_STT_DEVICE=cpu
REALTIME_LOCAL_STT_COMPUTE_TYPE=int8

REALTIME_LLM_PROVIDER=ollama
REALTIME_LLM_BASE_URL=http://host.docker.internal:11434/v1
REALTIME_LLM_MODEL=llama3

REALTIME_TTS_PROVIDER=piper
REALTIME_TTS_MODEL=/models/en_US-lessac-medium.onnx
REALTIME_TTS_PIPER_BIN=piper

REALTIME_LANGUAGE=en

# --- Asterisk (ARI + media) ---------------------------------------------------
ASTERISK_ARI_URL=http://asterisk:8088/ari
ASTERISK_ARI_USER=voicebot
# set a strong value in .env.gateway; renders configs/asterisk/ari.conf.template
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=voicebot
ASTERISK_EXTERNAL_MEDIA_HOST=gateway
ASTERISK_RTP_HOST=asterisk

# ARI template rendering (kept in sync with ASTERISK_ARI_* above)
ARI_USER=voicebot
ARI_PASSWORD=

# --- SIP trunk (renders configs/asterisk/pjsip.conf.template) -----------------
# In topology B these trunk credentials are provisioned by Cloud/operator, not
# owned by the customer. Fill them from your provisioning packet.
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_PROVIDER_HOST=sip.example-provider.com
PUBLIC_IP=

# --- Fail-closed safety -------------------------------------------------------
# Keep live calls DISABLED until registered + doctor-green + operator-approved.
REALTIME_LIVE_ENABLED=0
REALTIME_REQUIRE_OPERATOR_APPROVAL=0
